  "definitions": {
    "Ecoponto": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "example": "Ecoponto Central"
        },
        "latitude": {
          "type": "string",
          "example": "-23.5505"
        },
        "longitude": {
          "type": "string",
          "example": "-46.6333"
        },
        "descricao": {
          "type": "string",
          "example": "Ponto de coleta no centro"
        },
        "cep": {
          "type": "string",
          "example": "01000-000"
        },
        "logradouro": {
          "type": "string",
          "example": "Rua Exemplo"
        },
        "numero": {
          "type": "string",
          "example": "100"
        },
        "bairro": {
          "type": "string",
          "example": "Centro"
        },
        "cidade": {
          "type": "string",
          "example": "São Paulo"
        },
        "uf": {
          "type": "string",
          "example": "SP"
        },
        "nota": {
          "type": "number",
          "example": 5
        }
      },
      "required": [
        "nome",
        "latitude",
        "longitude"
      ]
    },
    "Lixeira": {
      "type": "object",
      "properties": {
        "ecoponto_id": {
          "type": "number",
          "example": 1
        },
        "uuid_sensor": {
          "type": "string",
          "example": "sensor-001"
        },
        "tipo": {
          "type": "string",
          "example": "PLASTICO"
        },
        "volume_max": {
          "type": "number",
          "example": 100
        },
        "nivel_cheio": {
          "type": "number",
          "example": 80
        }
      },
      "required": [
        "ecoponto_id",
        "uuid_sensor",
        "tipo",
        "volume_max",
        "nivel_cheio"
      ]
    }
