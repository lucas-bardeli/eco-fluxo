// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String    @unique
  senha              String
  perfil             Perfil    @default(MORADOR)
  login_code         String?
  login_code_expires DateTime?
  criado_em          DateTime  @default(now())

  @@map("usuarios")
}

model Ecoponto {
  id         Int       @id @default(autoincrement())
  nome       String
  latitude   String
  longitude  String
  descricao  String?
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  uf         String?
  nota       Int?
  criado_em  DateTime  @default(now())
  lixeiras   Lixeira[]

  @@map("ecopontos")
}

model Lixeira {
  id           Int           @id @default(autoincrement())
  ecoponto_id  Int
  uuid_sensor  String
  tipo         Tipo
  volume_max   Int
  nivel_cheio  Int
  criado_em    DateTime      @default(now())
  ecoponto     Ecoponto      @relation(fields: [ecoponto_id], references: [id], onDelete: Cascade)
  notificacoes Notificacao[]

  @@map("lixeiras")
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  lixeira_id Int
  titulo     String
  mensagem   String
  lida       Boolean
  criado_em  DateTime @default(now())
  lixeira    Lixeira  @relation(fields: [lixeira_id], references: [id], onDelete: Cascade)

  @@index([lixeira_id], map: "notificacoes_lixeira_id_fkey")
  @@map("notificacoes")
}

enum Perfil {
  MORADOR
  GESTOR
}

enum Tipo {
  PLASTICO
  VIDRO
  PAPEL
  METAL
  ORGANICO
}
